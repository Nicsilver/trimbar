{
  "manifest_version": 3,
  "name": "Trimbar",
  "version": "0.1.0",
  "description": "Keeps fullscreen video above the strip Trimbar hides at the bottom of a dying monitor.",
  "key": "",
  "icons": { "128": "icon128.png" },
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
